{
  "name": "web-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "docs:check": "node scripts/check-docs.mjs",
    "starter:copy": "node scripts/copy-starter.mjs",
    "startDev": "node scripts/server.mjs start dev",
    "startProd": "node scripts/server.mjs start prod",
    "stopDev": "node scripts/server.mjs stop dev",
    "stopProd": "node scripts/server.mjs stop prod"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0"
  },
  "type": "module"
}
